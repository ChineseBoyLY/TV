<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:titleTextColor="@color/white" android:title="全网资源" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
        <EditText android:id="@+id/keyword" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/shape_vod_list" android:hint="搜索指南内容" android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" android:paddingStart="16dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/white" android:textColorHint="@color/white_60" />
        <com.google.android.material.button.MaterialButton android:id="@+id/searchButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="搜索" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <LinearLayout android:id="@+id/categoryContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp" />
    </HorizontalScrollView>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="精选资源指南" android:textColor="@color/white_60" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp" />
</LinearLayout>
